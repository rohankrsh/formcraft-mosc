  "sqlQueries": [
    {
      "id": "query_1789278963593_hglv",
      "name": "patient_lookup",
      "operation": "select",
      "sql": "SELECT\n    p.patient_id,\n    p.mrno,\n    p.firstname,\n    p.middlename,\n    p.lastname,\n    p.dob,\n    (\n        SELECT vs.current_value\n        FROM (\n            SELECT current_value\n            FROM vitalsign\n            WHERE patient_id = p.patient_id\n              AND UPPER(TRIM(parameter_value)) = 'WEIGHT'\n              AND current_value IS NOT NULL\n            ORDER BY entered_datetime DESC\n        ) vs\n        WHERE ROWNUM = 1\n    ) AS weight,\n    (\n        SELECT ht.current_value\n        FROM (\n            SELECT current_value\n            FROM vitalsign\n            WHERE patient_id = p.patient_id\n              AND UPPER(TRIM(parameter_value)) = 'HEIGHT'\n              AND current_value IS NOT NULL\n            ORDER BY entered_datetime DESC\n        ) ht\n        WHERE ROWNUM = 1\n    ) AS height\nFROM patient p\nWHERE p.mrno = :mrno",
      "enabled": true,
      "executeOn": "fieldChange",
      "triggerFieldKey": "mrno",
