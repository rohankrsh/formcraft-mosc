              ]
            },
            {
              "id": "col_2",
              "width": 6,
              "fieldIds": [
                "fld_language"
              ]
            }
          ]
        },
        {
          "id": "row_2",
          "columns": [
            {
              "id": "col_3",
              "width": 12,
              "fieldIds": [
                "fld_interpreter"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sec_adl",
      "title": "Activities of Daily Living",
      "rows": [
        {
          "id": "row_3",
          "columns": [
            {
              "id": "col_4",
              "width": 12,
              "fieldIds": [
                "fld_adl_table"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sec_ulcer",
      "title": "Pressure Ulcer Assessment",
      "rows": [
        {
          "id": "row_4",
          "columns": [
            {
              "id": "col_5",
              "width": 12,
              "fieldIds": [
                "fld_pressure_ulcer"
              ]
            }
          ]
        },
        {
          "id": "row_5",
          "columns": [
            {
              "id": "col_6",
              "width": 6,
              "fieldIds": [
                "fld_ulcer_location"
              ]
            },
            {
              "id": "col_7",
              "width": 6,
              "fieldIds": [
                "fld_ulcer_stage"
              ]
            }
          ]
        },
        {
          "id": "row_6",
          "columns": [
            {
              "id": "col_8",
              "width": 6,
              "fieldIds": [
                "fld_ulcer_size"
              ]
            },
            {
              "id": "col_9",
              "width": 6,
              "fieldIds": [
                "fld_ulcer_treatment"
              ]
            }
          ]
        },
        {
          "id": "row_7",
          "columns": [
            {
              "id": "col_10",
              "width": 12,
              "fieldIds": [
                "fld_push_score"
              ]
            }
          ]
        }
      ]
    }
  ],
  "description": "Generated from LIFE HIS Nursing Module Requirements"
}