{
  "version": "1.0.0",
  "id": "emr_ipd_nurses_assessment",
  "title": "EMR IPD Nurses Initial Assessment",
  "settings": {
    "submitButtonText": "Submit Assessment",
    "submitAction": "download_json",
    "showResetButton": true,
    "theme": {
      "primaryColor": "#0056b3",
      "borderRadius": "md",
      "fontFamily": "sans-serif"
    },
    "primaryKeyColumn": "PATIENT_ID"
  },
  "fields": {
    "fld_start_time": {
      "id": "fld_start_time",
      "name": "start_time",
      "type": "text",
      "label": "Initial Assessment starting Time"
    },
    "fld_language": {
      "id": "fld_language",
      "name": "language_spoken",
      "type": "text",
      "label": "Language spoken"
    },
    "fld_interpreter": {
      "id": "fld_interpreter",
      "name": "need_interpreter",
      "type": "radio",
      "label": "Need of interpreter",
      "options": [
        {
          "label": "Yes",
          "value": "yes"
        },
        {
          "label": "No",
          "value": "no"
        }
      ]
    },
    "fld_adl_table": {
      "id": "fld_adl_table",
      "name": "adl_table",
      "type": "table",
      "label": "Ability to perform Activities of daily living",
      "tableConfig": {
        "columns": [
          {
            "id": "col_activity",
            "label": "Activity",
            "type": "text"
          },
          {
            "id": "col_independent",
            "label": "Independent",
            "type": "text"
          },
          {
            "id": "col_assisted",
            "label": "Assisted",
            "type": "text"
          },
          {
            "id": "col_dependent",
            "label": "Dependent",
            "type": "text"
          }
        ],
        "defaultRows": [
          {
            "col_activity": "Bathing"
          },
          {
            "col_activity": "Dressing"
          },
          {
            "col_activity": "Eating",
            "_headerCols": []
          },
          {
            "col_activity": "Walking/ Mobility"
          },
          {
            "col_activity": "Climbing stairs"
          },
          {
            "col_activity": "Toilet use"
          }
        ],
        "allowAddRows": true
      },
      "validation": {}
    },
    "fld_pressure_ulcer": {
      "id": "fld_pressure_ulcer",
      "name": "pressure_ulcer",
      "type": "radio",
      "label": "Existing Pressure Ulcer",
      "options": [
        {
          "label": "Yes",
          "value": "yes"
        },
        {
          "label": "No",
          "value": "no"
        }
      ]
    },
    "fld_ulcer_location": {
      "id": "fld_ulcer_location",
      "name": "ulcer_location",
      "type": "text",
      "label": "Location"
    },
    "fld_ulcer_stage": {
      "id": "fld_ulcer_stage",
      "name": "ulcer_stage",
      "type": "text",
      "label": "Stage/ Grade"
    },
    "fld_ulcer_size": {
      "id": "fld_ulcer_size",
      "name": "ulcer_size",
      "type": "text",
      "label": "Size"
    },
    "fld_ulcer_treatment": {
      "id": "fld_ulcer_treatment",
      "name": "ulcer_treatment",
      "type": "text",
      "label": "Existing Treatment"
    },
    "fld_push_score": {
      "id": "fld_push_score",
      "name": "push_total_score",
      "type": "number",
      "label": "Total PUSH Score"
    }
  },
  "layout": [
    {
      "id": "sec_general",
      "title": "Initial Assessment Details",
      "rows": [
        {
          "id": "row_1",
          "columns": [
            {
              "id": "col_1",
